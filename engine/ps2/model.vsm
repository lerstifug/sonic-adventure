; the PS2's VU1 program for a model's batch (engine/ps2/gs.cpp's
; ps2_vu_open and ps2_vu_close, which engine/ps2/sa1/models.h fills): the
; corners of one or more of a meshset's strips, each carried by the model's
; matrix to view space, projected, lit, textured, fogged, culled, and sent to
; the GS as one triangle strip by XGKICK. the strips join with no corner of
; their own: each strip's first two corners draw nothing, by XYZF2's ADC bit,
; which the GS takes as XYZF3.
;
; VU1's memory: qwords 0 to 63 hold the picture's fog table (strip.vsm's),
; 64 to 319 the palette models.h's draws light by, and from 320 two buffers
; of 352 qwords take turns (VIF's BASE and OFFSET). XTOP gives this batch's:
;
;   0       the fog's terms: density, fogged (0 or 1), 255 times one less
;           fogged, 4
;   1       x: the corners' count, an integer; y: 1 where they come
;           packed, as the model cache keeps them (gs.cpp's ps2_vu_pack),
;           else 0
;   2-5     the model's matrix, Ninja's rows: a point is a row times it
;   6       the screen's scale: focal x, focal y, the depth's most, and one
;           less highlighted
;   7       its bias: center x and y, as the GS's pixels place them; then
;           the highlight's share of the palette's offset and of the
;           corner's, each 0 or 1
;   8       the color's scale for the GS: red, green, blue and alpha's
;   9       1e30; the texture's scale, u and v of the stored sides over 255;
;           2048, the ADC bit of XYZF2's fourth word over 16
;   10      the light in the model's space: x, y, z, 0
;   11      the palette's color's scale: red, green, blue, alpha
;   12      what adds to it: red, green, blue, alpha, of 255
;   13      127.5, 255, 1/65536, 1/256
;   14      65536, 256, 0, 0
;   15      PROTOTYPE: 0; one over the reach's half width and half height,
;           in a corner's pixels before the divide over its depth; and
;           twice the near plane's depth. a corner whose pixels lie past
;           either, or nearer than the near plane, draws no triangle: CLIP
;           tests each, and a triangle any of whose three corners it put
;           outside takes the ADC bit, as a culled one does
;   16      the GIF tag of the strip: PRE, PRIM, PACKED, ST RGBAQ XYZF2,
;           which the corners after it follow as XGKICK sends them
;   17-     the corners, three qwords each: the point's x, y and z, and the
;           corner's word; the normal's x, y and z, and the corner's own
;           offset's most of its three, of 255; the u and v, in the
;           texture's 255 to a side, and 0, 0. the word is 2 where the
;           corner starts a strip, else the cull's turn for the triangle it
;           ends, 1 to drop it where its pixels turn one way, -1 the other,
;           0 never. packed, the normal and the offset's most, and the u
;           and v, come as whole numbers, the normal's three times 32767,
;           and the word in the third qword's w: the program first turns
;           them to floats in place, and the word to the first qword's w
;
; each corner's three qwords become what the GS takes of it, in place: ST
; with Q, RGBAQ and XYZF2, after the tag at 15. a corner reads all three
; before it writes, so the strip needs no room of its own. RGBAQ takes the
; Q of the ST before it.
;
; a palette entry is a qword: its color's red, green and blue as one whole
; number, red times 65536 plus green times 256 plus blue, which a float
; holds exactly; its offset's the same; its color's alpha; and its offset's
; most of its three. a corner takes the entry its normal's dot with the
; light picks, as the walk does (engine/psp/sa1/walk.h): 127.5 plus 127.5
; times the dot, held to 0 to 255. its color is the entry's times the
; scale, plus the add, times the GS's scale. a highlighted corner's alpha
; is its offset's most, unscaled, which the GS's HIGHLIGHT2 adds to the
; texel's three, as gs.cpp's send_packet gives it.
;
; the fog as strip.vsm's: the table's step of the square root of 1/z times
; the density, held to 1 to 255.
;
; a corner's w goes to start = max(w - 1, 0) and turn = w - 2 start, and
; its triangle draws nothing where turn times its pixels' area, plus start,
; is above 0. VF22 and VF23 hold the last two corners' pixels
        .vu
        .align 4
        .global VU1Model_CodeStart
        .global VU1Model_CodeEnd
VU1Model_CodeStart:
        NOP                     xtop VI02
        NOP                     NOP
        NOP                     ilw.x VI03, 1(VI02)
        NOP                     lq VF21, 0(VI02)
        NOP                     lq VF01, 2(VI02)
        NOP                     lq VF02, 3(VI02)
        NOP                     lq VF03, 4(VI02)
        NOP                     lq VF04, 5(VI02)
        NOP                     lq VF05, 6(VI02)
        NOP                     lq VF06, 7(VI02)
        NOP                     lq VF07, 8(VI02)
        NOP                     lq VF08, 9(VI02)
        NOP                     lq VF09, 10(VI02)
        NOP                     lq VF18, 11(VI02)
        NOP                     lq VF19, 12(VI02)
        NOP                     lq VF20, 13(VI02)
        NOP                     lq VF24, 14(VI02)
        NOP                     lq.yzw VF31, 15(VI02)
        NOP                     iaddiu VI05, VI02, 16
        NOP                     iaddiu VI04, VI02, 17
        sub.xy VF22, VF00, VF00 NOP
        sub.xy VF23, VF00, VF00 NOP
        NOP                     ilw.y VI09, 1(VI02)
        NOP                     iaddiu VI10, VI02, 17
        NOP                     iadd VI11, VI03, VI00
        NOP                     NOP
        NOP                     NOP
        NOP                     ibeq VI09, VI00, model_corner
        NOP                     NOP
model_unpack:
        NOP                     lq VF10, 0(VI10)
        NOP                     lq VF16, 1(VI10)
        NOP                     lq VF30, 2(VI10)
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        itof15.xyz VF16, VF16   NOP
        itof0.w VF16, VF16      NOP
        itof0 VF30, VF30        NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulw.w VF10, VF30, VF00w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     sq.w VF10, 0(VI10)
        NOP                     sq VF16, 1(VI10)
        NOP                     sq VF30, 2(VI10)
        NOP                     iaddiu VI10, VI10, 3
        NOP                     isubiu VI11, VI11, 1
        NOP                     NOP
        NOP                     ibne VI11, VI00, model_unpack
        NOP                     NOP
model_corner:
        NOP                     lq VF10, 0(VI04)
        NOP                     lq VF16, 1(VI04)
        NOP                     lq VF30, 2(VI04)
        NOP                     NOP
        NOP                     NOP
        mulax ACC, VF01, VF10x  NOP
        madday ACC, VF02, VF10y NOP
        maddaz ACC, VF03, VF10z NOP
        maddw VF11, VF04, VF00w NOP
        mul.xyz VF17, VF16, VF09 NOP
        subw.w VF12, VF10, VF00w NOP
        muly.x VF30, VF30, VF08y NOP
        mulz.y VF30, VF30, VF08z NOP
        NOP                     div Q, VF00w, VF11z
        mulax.w ACC, VF00, VF17x NOP
        madday.w ACC, VF00, VF17y NOP
        maddz.w VF17, VF00, VF17z NOP
        maxx.w VF12, VF12, VF00x NOP
        mul.xy VF15, VF11, VF05 NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        muly.x VF26, VF15, VF31y NOP
        mulz.y VF26, VF15, VF31z NOP
        subw.z VF26, VF11, VF31w NOP
        mulz.w VF26, VF00, VF11z NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        clipw.xyz VF26, VF26w   NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     fcand VI01, 0x03ffff
        NOP                     NOP
        NOP                     mfir.x VF12, VI01
        NOP                     NOP
        itof0.x VF12, VF12      NOP
        mulx.w VF17, VF17, VF20x NOP
        sub.w VF14, VF10, VF12  NOP
        addx.w VF17, VF17, VF20x NOP
        sub.w VF14, VF14, VF12  NOP
        maxx.w VF17, VF17, VF00x NOP
        miniy.w VF17, VF17, VF20y NOP
        ftoi0.w VF17, VF17      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     mtir VI07, VF17w
        NOP                     NOP
        NOP                     iaddiu VI07, VI07, 64
        NOP                     NOP
        NOP                     lq VF25, 0(VI07)
        NOP                     waitq
        mulq.xy VF15, VF15, Q   NOP
        mulq.z VF15, VF05, Q    NOP
        mulq.xy VF30, VF30, Q   NOP
        addq.z VF30, VF00, Q    NOP
        mulq.x VF31, VF21, Q    NOP
        add.xy VF15, VF15, VF06 NOP
        NOP                     NOP
        NOP                     NOP
        maxw.x VF31, VF31, VF00w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        miniy.x VF31, VF31, VF20y NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     sqrt Q, VF31x
        NOP                     waitq
        addq.x VF31, VF00, Q    NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulw.x VF31, VF31, VF21w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        ftoi0.x VF31, VF31      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     mtir VI08, VF31x
        NOP                     NOP
        NOP                     NOP
        NOP                     lq.x VF26, 0(VI08)
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        muly.x VF26, VF26, VF21y NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        addz.x VF14, VF26, VF21z NOP
        mulz.x VF26, VF25, VF20z NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        ftoi0.x VF26, VF26      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        itof0.x VF26, VF26      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulx.x VF27, VF24, VF26x NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        sub.x VF27, VF25, VF27  NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulw.x VF28, VF27, VF20w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        ftoi0.x VF28, VF28      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        itof0.x VF28, VF28      NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        muly.x VF31, VF28, VF24y NOP
        addx.x VF29, VF00, VF26x NOP
        addx.y VF29, VF00, VF28x NOP
        mulz.w VF29, VF00, VF25z NOP
        sub.x VF31, VF27, VF31  NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        addx.z VF29, VF00, VF31x NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mul VF29, VF29, VF18    NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        add VF29, VF29, VF19    NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mul VF29, VF29, VF07    NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulaw.w ACC, VF29, VF05w NOP
        maddaz.w ACC, VF25, VF06z NOP
        maddw.w VF29, VF16, VF06w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        ftoi0 VF13, VF29        NOP
        sub.xy VF26, VF23, VF22 NOP
        sub.xy VF27, VF15, VF22 NOP
        add.xy VF22, VF00, VF23 NOP
        add.xy VF23, VF00, VF15 NOP
        NOP                     NOP
        NOP                     NOP
        muly.x VF28, VF26, VF27y NOP
        mulx.y VF28, VF26, VF27x NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        suby.x VF28, VF28, VF28y NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulw.x VF28, VF28, VF14w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        mulx.x VF28, VF28, VF08x NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        addw.x VF28, VF28, VF12w NOP
        NOP                     NOP
        NOP                     NOP
        NOP                     NOP
        max.x VF28, VF28, VF12  NOP
        NOP                     NOP
